# Copia este archivo a `.env` y ajusta los valores.

# URL pública del sitio (sin barra final). Usada en index.html para <link canonical>
# y las etiquetas Open Graph / Twitter (deben ser URLs absolutas).
VITE_SITE_URL=https://tu-dominio.com

# Analítica Umami auto-hospedada. Déjalas vacías para desactivar la analítica.
# VITE_UMAMI_SRC: URL del script del tracker de tu instancia Umami.
# VITE_UMAMI_WEBSITE_ID: el UUID del sitio creado en el panel de Umami.
VITE_UMAMI_SRC=https://analytics.tu-dominio.com/script.js
VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
